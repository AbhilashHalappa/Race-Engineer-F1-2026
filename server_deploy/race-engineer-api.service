[Unit]
Description=Race Engineer Data Server API
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=raceadmin
Group=raceadmin
WorkingDirectory=/srv/race-engineer/server/app
ExecStart=/srv/race-engineer/server/app/.venv/bin/uvicorn src.main:app --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=5s
StandardOutput=append:/srv/race-engineer/server/app/logs/api.log
StandardError=append:/srv/race-engineer/server/app/logs/api-error.log
[Install]
WantedBy=multi-user.target
